# Northstar Enterprise AI Transformation Platform - ingestion configuration
# Copy to .env and adjust as needed. Never commit a real .env file.

# Comma-separated knowledge-base directories to scan (relative to project root, or absolute)
KNOWLEDGE_BASE_DIRS=enterprise_knowledge_base

# Comma-separated file extensions to ingest (leading dot optional)
SUPPORTED_EXTENSIONS=.md

# Chunking is character-based (not token-based) in this milestone
CHUNK_SIZE=1500
CHUNK_OVERLAP=200

# DEBUG, INFO, WARNING, ERROR, or CRITICAL
LOG_LEVEL=INFO

# Where ingestion artifacts (chunks.jsonl, errors.json, summary.json) are written
INGESTION_OUTPUT_DIR=data/processed

# --- Milestone 2: semantic indexing and retrieval ---

# 'local' (default, offline, no API key needed) or 'openai'
EMBEDDING_PROVIDER=local

# Defaults: local-hashing-v1 for 'local', text-embedding-3-small for 'openai'
# EMBEDDING_MODEL=

EMBEDDING_DIMENSIONS=512

# Only required when EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=

# Where the persistent vector store (embeddings.npy, chunk_metadata.jsonl,
# index_state.json) is written
VECTOR_STORE_DIR=vector_store

# Default number of chunks returned per retrieval query
RETRIEVAL_TOP_K=5

# --- Milestone 3: grounded RAG assistant ---

# 'fake' (default, offline, no API key needed -- deterministic labeled
# test response) or 'openai'
LLM_PROVIDER=fake

# Default: gpt-4o-mini for 'openai'
# LLM_MODEL=

# Only required when LLM_PROVIDER=openai. Separate from OPENAI_API_KEY above
# so embeddings and generation can use different keys/accounts if desired.
# LLM_API_KEY=

LLM_TEMPERATURE=0
LLM_MAX_OUTPUT_TOKENS=1024
LLM_TIMEOUT_SECONDS=30

# Context construction bounds (character-based, not token-based)
CONTEXT_MAX_CHARACTERS=6000
CONTEXT_MAX_CHUNKS=6
CONTEXT_MIN_SCORE=0.1

# Guardrails
MAX_QUESTION_LENGTH=2000

# Insufficient-context thresholds (evaluated on raw retrieval results,
# before context filtering)
INSUFFICIENT_CONTEXT_MIN_RESULTS=1
INSUFFICIENT_CONTEXT_MIN_SCORE=0.15
